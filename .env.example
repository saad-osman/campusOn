# Copy to backend/.env for the backend and frontend/.env.local for the frontend
# (the Makefile's `make setup` does this split for you).

# --- Backend ---
APP_NAME=Lodestar
ENV=development
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///./scholarradar.db
FRONTEND_ORIGIN=http://localhost:3000

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
COOKIE_NAME=sr_session

# AI provider. With no key for the chosen provider the app runs in demo mode (rule-based
# extraction and template drafts, no external calls).
#   LLM_PROVIDER=anthropic          -> ANTHROPIC_API_KEY
#   LLM_PROVIDER=gemini             -> LLM_API_KEY (free key: https://aistudio.google.com/apikey)
#   LLM_PROVIDER=openai_compatible  -> LLM_API_KEY + LLM_BASE_URL + both model names
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# Leave empty for the provider's defaults (anthropic: claude-haiku-4-5-20251001 /
# claude-sonnet-5-5; gemini: gemini-2.5-flash for both).
EXTRACTION_MODEL=
WRITING_MODEL=
DEMO_MODE=false
# Background jobs: re-scrape every 6h, expiry sweep daily, digest weekly.
ENABLE_SCHEDULER=true

SCRAPER_CONTACT_EMAIL=demo@scholarradar.local
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_TIMEOUT_SECONDS=15.0

# Optional: Semantic Scholar API key (professor finder works without one, more slowly).
SEMANTIC_SCHOLAR_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@scholarradar.local
TELEGRAM_BOT_TOKEN=

UPLOAD_DIR=./uploads
MAX_CV_BYTES=5242880

# --- Frontend ---
BACKEND_URL=http://localhost:8000
